    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.21.12",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.2",
    "@vitest/coverage-v8": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^17.4.6",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.6",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.5"
  },
  "packageManager": "npm@11.7.0"
